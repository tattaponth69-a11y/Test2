    // --- Preference Toggle Filter ---
    function toggleTag(btn, cat) {
      if (btn.classList.contains('active')) {
        btn.classList.remove('active', 'bg-brand-800', 'text-white', 'border-brand-800');
        btn.classList.add('bg-stone-50', 'text-stone-700', 'border-stone-200');
        currentSelectedCategories = currentSelectedCategories.filter(c => c !== cat);
      } else {
        btn.classList.add('active', 'bg-brand-800', 'text-white', 'border-brand-800');
        btn.classList.remove('bg-stone-50', 'text-stone-700', 'border-stone-200');
        currentSelectedCategories.push(cat);
      }
      filterDestinations();
    }

    function filterDestinations() {
      const searchTxt = document.getElementById('search-input')?.value.trim().toLowerCase() || '';

      const filtered = placesData.filter(item => {
        const matchesCategory = currentSelectedCategories.length === 0 || 
          currentSelectedCategories.some(cat => item.category.includes(cat));
        
        const matchesSearch = !searchTxt || 
          item.name.toLowerCase().includes(searchTxt) ||
          item.province.toLowerCase().includes(searchTxt) ||
          item.desc.toLowerCase().includes(searchTxt);

        return matchesCategory && matchesSearch;
      });

      renderDestinations(filtered);
    }

    function quickFilterRegion(regionCode) {
      navigateTo('home');
      const filtered = placesData.filter(p => p.region === regionCode);
      renderDestinations(filtered);
    }

