      }
    }

    function addBasketToDay(btn, placeName) {
      alert(`เพิ่ม "${placeName}" ลงในแผนการเดินทางเรียบร้อยแล้ว`);
      btn.innerText = '✓ ใส่แล้ว';
      btn.classList.add('opacity-50');
      btn.disabled = true;
      myPlannerPlaces.push(placeName);
      updatePlannerBadge();
    }

    function addToTrip(placeName) {
      myPlannerPlaces.push(placeName);
      updatePlannerBadge();
      alert(`✓ เพิ่ม "${placeName}" ลงในแผนการเดินทางแล้ว! สามารถเปิดดูได้ที่แท็บ 'วางแผนการเดินทาง'`);
    }

    function updatePlannerBadge() {
      const count = document.querySelectorAll('.timeline-day .relative.bg-white').length + 1;
      const tripBadge = document.getElementById('trip-badge');
      const plannerCount = document.getElementById('planner-count');
      if (tripBadge) tripBadge.innerText = count;
      if (plannerCount) plannerCount.innerText = `${count} สถานที่ในแผน`;
    }

    function renameTrip() {
      const newName = prompt('แก้ไขชื่อทริปของคุณ:', document.getElementById('planner-title').innerText);
      if (newName) {
        document.getElementById('planner-title').innerText = newName;
      }
    }

    function optimizeRouteAlert() {
      alert('✨ เส้นทางได้รับการจัดลำดับอัตโนมัติเรียบร้อย! ช่วยลดระยะทางขับรถ 14 กิโลเมตร และประหยัดเวลา 45 นาที');
    }

    function exportTripPDF() {
      alert('📄 กำลังสร้างเอกสารสรุปทริป (Travel Itinerary PDF) สไตล์มินิมอล พร้อมลิงก์แผนที่นำทางออฟไลน์...');
    }

    function downloadOfflinePrompt() {
      alert('💾 บันทึกแผนที่และข้อมูลทริปออฟไลน์ลงอุปกรณ์เรียบร้อย สามารถเปิดใช้งานได้แม้อยู่บนดอยที่ไม่มีสัญญาณ');
    }

    function addNewCustomPlace() {
      const name = prompt('กรอกชื่อสถานที่ หรือร้านอาหารที่ต้องการเพิ่ม:');
      if (name) {
        alert(`เพิ่ม "${name}" ลงในตะกร้าสถานที่เรียบร้อย!`);
        const basket = document.getElementById('basket-items');
        if (basket) {
          const div = document.createElement('div');
          div.className = 'flex items-center justify-between p-2.5 rounded-xl bg-stone-50 border border-stone-200/80';
          div.innerHTML = `
            <div>
              <h5 class="text-xs font-bold text-stone-900">${name}</h5>
              <span class="text-[11px] text-stone-500">สถานที่กำหนดเอง</span>
            </div>
            <button onclick="addBasketToDay(this, '${name}')" class="text-xs bg-brand-800 hover:bg-brand-900 text-white px-2.5 py-1 rounded-lg">
              + ใส่แผน
            </button>
          `;
          basket.prepend(div);
        }
      }
    }

    // --- Place Detail Page ---
    function openPlaceDetail(placeId) {
      const place = placesData.find(p => p.id === placeId) || placesData[0];
      
      document.getElementById('detail-title').innerText = place.name;
      document.getElementById('detail-province').innerText = place.province;
      document.getElementById('detail-breadcrumb').innerText = place.name;
      document.getElementById('detail-desc').innerText = place.desc;
      document.getElementById('detail-main-img').src = place.image;

      navigateTo('detail');
    }

    function bookmarkCurrentPlace() {
      const btn = document.getElementById('btn-bookmark');
      btn.innerHTML = '<i data-lucide="bookmark-check" class="w-4 h-4 text-brand-800"></i> บันทึกแล้ว';
      lucide.createIcons();
      alert('🔖 บันทึกสถานที่นี้ลงในรายการโปรดเรียบร้อย');
    }

    function addCurrentToPlanner() {
      const title = document.getElementById('detail-title').innerText;
      addToTrip(title);
    }

    function sharePlaceLink() {
      navigator.clipboard?.writeText(window.location.href);
      alert('🔗 คัดลอกลิงก์สถานที่และคู่มือการเดินทางแล้ว สามารถส่งให้เพื่อนร่วมทริปได้ทันที');
    }

    function toggleLike(btn) {
      const icon = btn.querySelector('i');
      if (btn.classList.contains('liked')) {
        btn.classList.remove('liked');
        btn.classList.remove('text-rose-500');
        btn.classList.add('text-stone-700');
      } else {
        btn.classList.add('liked');
        btn.classList.add('text-rose-500');
        btn.classList.remove('text-stone-700');
      }
    }

    // Initialize application
    document.addEventListener('DOMContentLoaded', () => {
      renderDestinations(placesData);
      lucide.createIcons();
    });
  </script>
</body>
</html>
